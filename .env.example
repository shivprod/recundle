# Required: the client secret of the Google OAuth "Web application" client.
# It also keys the sealed session cookie, so changing it signs everyone out.
GOOGLE_WEB_CLIENT_SECRET=

# Optional: a different Google OAuth client ID (defaults to Recundle's client).
# GOOGLE_CLIENT_ID=

# Optional: turns on AI reading of loan emails (closure letters, NOCs, sanction letters).
# ANTHROPIC_API_KEY=
