# Server (Vercel project environment variable). Never commit real values.
# Client secret of the Google OAuth "Web application" client; also keys the
# encrypted sign-in sessions, so changing it signs everyone out.
GOOGLE_WEB_CLIENT_SECRET=

# Optional (browser): override the Google web client ID or the backend URL.
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_RECUNDLE_API_URL=
